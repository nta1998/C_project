{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "asFile",
      "type": "pickString",
      "description": "Which .as file should the assembler read?",
      "default": "Tests/e2e/valid_basic.as",
      "options": [
        "Tests/e2e/valid_basic.as",
        "Tests/e2e/valid_data.as",
        "Tests/e2e/valid_macro.as",
        "Tests/e2e/valid_extern.as",
        "Tests/e2e/error_macro.as",
        "Tests/e2e/error_syntax.as",
        "Tests/e2e/error_symbols.as",
        "Tests/first_pass_valid.as",
        "Tests/first_pass_errors.as",
        "Tests/ps.as"
      ]
    },
    {
      "id": "caseName",
      "type": "pickString",
      "description": "Which e2e case should run? (empty = all cases)",
      "default": "valid_macro",
      "options": [
        "valid_basic",
        "valid_data",
        "valid_macro",
        "valid_extern",
        "error_macro",
        "error_syntax",
        "error_symbols",
        ""
      ]
    }
  ],
  "configurations": [
  
    {
      "name": "assembler - valid file",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/assembler",
      "args": [
        "Tests/e2e/valid_basic.as"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "preLaunchTask": "build",
      "terminal": "integrated"
    },
    {
      "name": "assembler - errors file",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/assembler",
      "args": [
        "Tests/e2e/error_syntax.as"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "preLaunchTask": "build",
      "terminal": "integrated"
    },
    {
      "name": "assembler - pick a file...",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/assembler",
      "args": [
        "${input:asFile}"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "preLaunchTask": "build",
      "terminal": "integrated"
    },
    {
      "name": "assembler - stop at entry",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/assembler",
      "args": [
        "Tests/e2e/valid_basic.as"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "preLaunchTask": "build",
      "stopOnEntry": true,
      "terminal": "integrated"
    },
    {
      "name": "debug parser - stop on every line",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/assembler",
      "args": [
        "${input:asFile}"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "preLaunchTask": "build",
      "terminal": "integrated",
      "initCommands": [
        "breakpoint set -n line_split"
      ]
    },
    {
      "name": "debug first_pass - stop at entry",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/assembler",
      "args": [
        "${input:asFile}"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "preLaunchTask": "build",
      "terminal": "integrated",
      "initCommands": [
        "breakpoint set -n first_pass"
      ]
    },
    {
      "name": "debug second_pass - stop at entry",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/assembler",
      "args": [
        "${input:asFile}"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "preLaunchTask": "build",
      "terminal": "integrated",
      "initCommands": [
        "breakpoint set -n second_pass"
      ]
    },
    {
      "name": "debug parser alone (parser_driver)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/build/parser_driver",
      "args": [
        "${input:asFile}"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "preLaunchTask": "build parser_driver",
      "terminal": "integrated",
      "initCommands": [
        "breakpoint set -n line_split"
      ]
    },
    {
      "name": "debug first_pass alone (fp_driver)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/build/fp_driver",
      "args": [
        "${input:asFile}"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "preLaunchTask": "build fp_driver",
      "terminal": "integrated",
      "initCommands": [
        "breakpoint set -n first_pass"
      ]
    },
    {
      "name": "debug second_pass alone (sp_driver)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/build/sp_driver",
      "args": [
        "${input:asFile}"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "preLaunchTask": "build sp_driver",
      "terminal": "integrated",
      "initCommands": [
        "breakpoint set -n second_pass"
      ]
    },
    {
      "name": "check - diagnose a case (source + memory)",
      "type": "node-terminal",
      "request": "launch",
      "command": "make check CASE=${input:caseName}",
      "cwd": "${workspaceFolder}/Final_Project"
    },
    {
      "name": "e2e - compare expected vs actual",
      "type": "node-terminal",
      "request": "launch",
      "command": "make e2e CASE=${input:caseName}",
      "cwd": "${workspaceFolder}/Final_Project"
    },
    {
      "name": "assembler - debug (stops at memory faults)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/assembler",
      "args": [
        "${input:asFile}"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "preLaunchTask": "build",
      "terminal": "integrated",
      "initCommands": [
        "settings set target.process.stop-on-sharedlibrary-events false"
      ]
    },
    {
      "name": "[official VS Code only] assembler (cppdbg)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/Final_Project/assembler",
      "args": [
        "Tests/e2e/valid_basic.as"
      ],
      "cwd": "${workspaceFolder}/Final_Project",
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "build",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
