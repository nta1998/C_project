; ============================================================
; first_pass_data.as
; קובץ בדיקה שמתמקד בהנחיות הנתונים (.db / .dh / .dw / .asciz).
; הקובץ תקין לחלוטין — first_pass אמור להחזיר TRUE.
;
; ההערה בסוף כל שורה מציינת את ערך DC *לפני* השורה ואת מספר
; הבתים שהיא מוסיפה. DC מתחיל ב-0 ומוזז ב-ICF בסוף המעבר (step 19).
;
; ICF צפוי = 100 + 4*8  = 132   (8 הוראות)
; DCF צפוי = 80                 (ראה הסיכום בתחתית)
; ============================================================

; --- מקטע קוד קצר, רק כדי ש-ICF יזוז ותהיה הזזה אמיתית ב-step 19 ---
MAIN:   add  $3,$5,$9        ; IC 100
        sub  $1,$2,$3        ; IC 104
        la   BYTES           ; IC 108   הפניה לתווית נתונים
        la   WORDS           ; IC 112
        la   TEXT            ; IC 116
        bgt  $4,$2,END       ; IC 120
        jmp  MAIN            ; IC 124
END:    hlt                  ; IC 128

; ============================================================
; .db — בית לכל ערך (טווח -128..127)
; ============================================================
BYTES:  .db 6,-9,7           ; DC 0   +3
        .db 0                ; DC 3   +1   ערך בודד
        .db 127              ; DC 4   +1   מקסימום
        .db -128             ; DC 5   +1   מינימום
        .db 1, 2, 3          ; DC 6   +3   רווחים אחרי הפסיקים
        .db  4 , 5 , 6       ; DC 9   +3   רווחים משני צדי הפסיק
        .db	7,8             ; DC 12  +2   טאב לפני האופרנדים

; ============================================================
; .dh — 2 בתים לכל ערך (טווח -32768..32767)
; ============================================================
HALVES: .dh 27056,-2         ; DC 14  +4
        .dh 32767            ; DC 18  +2   מקסימום
        .dh -32768           ; DC 20  +2   מינימום
        .dh 0,0,0,0          ; DC 22  +8   ארבעה ערכים

; ============================================================
; .dw — 4 בתים לכל ערך
; ============================================================
WORDS:  .dw 31,-12           ; DC 30  +8
        .dw 2147483647       ; DC 38  +4   מקסימום
        .dw -2147483648      ; DC 42  +4   מינימום
        .dw 100              ; DC 46  +4

; ============================================================
; .asciz — תו לכל בית + '\0' מסיים
; ============================================================
TEXT:   .asciz "abc"         ; DC 50  +4   3 תווים + '\0'
        .asciz ""            ; DC 54  +1   מחרוזת ריקה — רק '\0'
        .asciz "a"           ; DC 55  +2   תו בודד
        .asciz "Hello World" ; DC 57  +12  רווח בתוך המחרוזת
        .asciz "a,b,c"       ; DC 69  +6   פסיקים בתוך המחרוזת (לא מפרידים!)

; ============================================================
; הנחיות ללא תווית — חייבות להיות מטופלות בדיוק כמו עם תווית
; ============================================================
        .db 42               ; DC 75  +1

; ============================================================
; .entry / .extern — לא תופסים מקום, DC לא זז
; ============================================================
.entry BYTES
.entry K
.extern vall
.extern external_label

K:      .dw 0                ; DC 76  +4   תווית של .entry שמוגדרת כאן

; ============================================================
; סיכום צפוי:
;   ICF = 132
;   DCF = 80
;
;   טבלת סמלים (לפני ההזזה של step 19):
;     MAIN    100  code
;     END     128  code
;     BYTES     0  data   → אחרי הזזה 132
;     HALVES   14  data   → אחרי הזזה 146
;     WORDS    30  data   → אחרי הזזה 162
;     TEXT     50  data   → אחרי הזזה 182
;     K        80  data   → אחרי הזזה 208  (וגם entry)
;     vall          external
;     external_label external
; ============================================================
