; ============================================================
; first_pass_errors.as
; קובץ בדיקה שכל שורה בו מכילה שגיאה אחת שה-first_pass אמור לתפוס.
; בסוף כל שורה מופיע קוד השגיאה הצפוי (ERR_CODE_x מתוך errors.h).
; הפונקציה חייבת להחזיר FALSE (step 17).
; התוצאות הצפויות: Tests/Exepted/first_pass_errors.expected.txt
; ============================================================

; --- שגיאות בהגדרת תווית (22-28) ---
1abc:   add  $1,$2,$3        ; ERR_CODE_22  תווית לא מתחילה באות
lab#el: add  $1,$2,$3        ; ERR_CODE_23  תו לא חוקי בתווית
verylongla0000000000000000000bel: hlt ; ERR_CODE_24  תווית באורך 32 תווים
add:    hlt                  ; ERR_CODE_25  תווית זהה לשם הוראה
LOOP :  add  $1,$2,$3        ; ERR_CODE_26  רווח בין שם התווית ל-':'
LOOP    add  $1,$2,$3        ; ERR_CODE_27  חסר ':' אחרי שם התווית
DUP:    add  $1,$2,$3        ; תקין - הגדרה ראשונה
DUP:    sub  $1,$2,$3        ; ERR_CODE_28  הגדרה כפולה של אותה תווית

; --- שגיאות בשם ההוראה (21) ---
        addd $1,$2,$3        ; ERR_CODE_21  ההוראה לא קיימת
        .dx  5               ; ERR_CODE_21  הנחיה לא קיימת

; --- שגיאות במספר האופרנדים (9) ---
        add  $1,$2           ; ERR_CODE_9   חסר אופרנד
        add  $1,$2,$3,$4     ; ERR_CODE_9   אופרנד עודף
        move $1,$2,$3        ; ERR_CODE_9   move מקבל 2 בלבד
        hlt  $1              ; ERR_CODE_9   hlt ללא אופרנדים

; --- שגיאות בסוג האופרנד (10, 13) ---
        add  $1,$2,7         ; ERR_CODE_10  מספר במקום רגיסטר
        addi $1,$2,$3        ; ERR_CODE_10  רגיסטר במקום immediate
        add  $1,$32,$3       ; ERR_CODE_13  רגיסטר מחוץ ל-$0-$31
        add  $1,$-4,$3       ; ERR_CODE_13  רגיסטר שלילי

; --- שגיאות במספרים (11, 12) ---
        addi $1,3.5,$2       ; ERR_CODE_11  מספר לא שלם
        addi $1,abc,$2       ; ERR_CODE_11  לא מספר בכלל
        addi $1,40000,$2     ; ERR_CODE_12  immediate מעל 32767
        addi $1,-40000,$2    ; ERR_CODE_12  immediate מתחת ל--32768

; --- שגיאות פסיקים (16, 17) ---
        add  $1,,$2          ; ERR_CODE_17  פסיק כפול
        add  $1,$2,          ; ERR_CODE_16  פסיק בסוף השורה
        ,$1,$2,$3            ; ERR_CODE_16  פסיק בתחילת השורה
        add  $1 $2,$3        ; ERR_CODE_16  חסר פסיק בין אופרנדים

; --- שגיאות מחרוזת (18, 19) ---
STR1:   .asciz hello         ; ERR_CODE_18  חסר '"' בתחילת המחרוזת
STR2:   .asciz "hello        ; ERR_CODE_19  חסר '"' בסוף המחרוזת

; --- שורה ארוכה מ-80 תווים (8) ---
        add  $1,$2,$3                                                          ; ERR_CODE_8
